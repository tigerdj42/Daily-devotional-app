rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* There is no Google Sign-In any more — identity comes from the
       in-app profile picker. The app still opens a SILENT anonymous
       Firebase Auth session purely as a gate, so these rules can
       require an authenticated caller.

       Why not `allow read, write: if true`: projectId and apiKey ship
       in firebase-config.js, which is served publicly, so open rules
       would let anyone on the internet read every reflection, delete
       all of it, or write until the quota is exhausted.

       Within the family app all profiles may read each other's
       reflections — that's the point of reading together. */

    function signedIn() {
      return request.auth != null;
    }

    /* /reflections/{profileId}/days/{day} */
    match /reflections/{profileId}/days/{day} {
      allow read, write: if signedIn();
    }

    /* /milestones/{profileId}/items/{id} */
    match /milestones/{profileId}/items/{id} {
      allow read, write: if signedIn();
    }

    /* Push subscription endpoints. */
    match /subscriptions/{profileId} {
      allow read, write: if signedIn();
    }

    /* Anything not matched above stays denied by default. */
  }
}
